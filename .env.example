HEADROOM_IMAGE=ghcr.io/headroomlabs-ai/headroom:latest
HEADROOM_CONTAINER_NAME=headroom-default
HEADROOM_HOST_HOME=/Users/user_name
HEADROOM_HOST_IP=127.0.0.1
HEADROOM_PORT=8787
HEADROOM_MODE=cache
HEADROOM_BACKEND=openai
HEADROOM_CACHE_DIR=/Users/user_name/.cache/headroom-docker
AWS_REGION=us-gov-west-1
